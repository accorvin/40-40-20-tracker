# Jira Configuration
JIRA_TOKEN=your-personal-access-token
JIRA_HOST=https://issues.redhat.com

# AWS Configuration
S3_BUCKET=40-40-20-tracker-data-dev

# Firebase Configuration (optional - defaults are provided in src/config/firebase.js)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=

# API Endpoint (optional - defaults to /api which proxies to local dev server)
# VITE_API_ENDPOINT=

# Local dev server port (optional - defaults to 3001)
# API_PORT=3001
