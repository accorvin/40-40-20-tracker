# Jira Configuration
JIRA_HOST=https://redhat.atlassian.net
JIRA_TOKEN=your-atlassian-api-token
JIRA_EMAIL=your-email@redhat.com

# AWS Configuration
S3_BUCKET=acorvin-40-40-20-tracker

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
# VITE_FIREBASE_AUTH_DOMAIN=ai-engineering-jira-tracking.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=ai-engineering-jira-tracking

# API Endpoint (optional - defaults to /api which proxies to local dev server)
# VITE_API_ENDPOINT=

# Local dev server port (optional - defaults to 3001)
# API_PORT=3001
